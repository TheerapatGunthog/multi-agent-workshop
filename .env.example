# true  = /chat ตอบจาก contract (ไม่ต้องมี LLM) คำถามที่มีคำว่า "เอกสาร" จะได้ mock โหมดเอกสาร
# false = /chat เรียก agent จริง (workshop 1: agent.py, หลัง Step 4: agents/orchestrator.py)
MOCK_MODE=true

# LLM แบบ OpenAI-compatible (เช่น vLLM) ต้องรองรับ tool calling และ response_format แบบ json_schema
# ถ้ารันบนเครื่องตัวเองให้ใช้ host.docker.internal แทน localhost
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=

# Embedding สำหรับ ingest และ docs-mcp (เว้นว่าง BASE_URL/API_KEY = ใช้ค่าเดียวกับ LLM)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

QDRANT_COLLECTION=docs
CORS_ORIGINS=http://localhost:3000

# MCP servers (Step 2) ค่า default ใช้ได้เลยเมื่อรันผ่าน docker compose
DOCS_MCP_URL=http://docs-mcp:8000/mcp
HR_MCP_URL=http://hr-mcp:8000/mcp

# Memory (Step 3) ตั้งต่ำไว้ให้เห็นการ summarize ภายในไม่กี่ turn
MEMORY_TOKEN_BUDGET=1500
